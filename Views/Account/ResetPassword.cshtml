@model ChatApp.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="text-center mb-4">
    <div class="bg-success bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
         style="width:64px;height:64px">
        <i class="bi bi-shield-check text-success fs-3"></i>
    </div>
    <h5 class="fw-bold mb-1">Reset Password</h5>
    <p class="text-muted small">Enter your new password below</p>
</div>

<form asp-action="ResetPassword" method="post">
    <input asp-for="Token" type="hidden" />
    <input asp-for="Email" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

    <div class="mb-3">
        <label asp-for="Password" class="form-label fw-semibold small"></label>
        <div class="input-group">
            <span class="input-group-text bg-light border-end-0"><i class="bi bi-lock text-muted"></i></span>
            <input asp-for="Password" class="form-control border-start-0 ps-0" placeholder="New password" id="pwd1" />
            <button type="button" class="btn btn-light border" onclick="togglePwd('pwd1','eye1')">
                <i class="bi bi-eye" id="eye1"></i>
            </button>
        </div>
        <span asp-validation-for="Password" class="text-danger small"></span>
    </div>

    <div class="mb-4">
        <label asp-for="ConfirmPassword" class="form-label fw-semibold small"></label>
        <div class="input-group">
            <span class="input-group-text bg-light border-end-0"><i class="bi bi-lock-fill text-muted"></i></span>
            <input asp-for="ConfirmPassword" class="form-control border-start-0 ps-0" placeholder="Confirm password" id="pwd2" />
            <button type="button" class="btn btn-light border" onclick="togglePwd('pwd2','eye2')">
                <i class="bi bi-eye" id="eye2"></i>
            </button>
        </div>
        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn btn-success w-100 py-2 fw-semibold">
        <i class="bi bi-check-circle me-2"></i>Reset Password
    </button>

    <div class="text-center mt-3">
        <a asp-action="Login" class="small text-decoration-none">
            <i class="bi bi-arrow-left me-1"></i>Back to Login
        </a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePwd(id, iconId) {
            const input = document.getElementById(id);
            const icon = document.getElementById(iconId);
            input.type = input.type === 'password' ? 'text' : 'password';
            icon.className = input.type === 'password' ? 'bi bi-eye' : 'bi bi-eye-slash';
        }
    </script>
}
