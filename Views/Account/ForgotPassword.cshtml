@model ChatApp.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="text-center mb-4">
    <div class="bg-warning bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
         style="width:64px;height:64px">
        <i class="bi bi-lock-fill text-warning fs-3"></i>
    </div>
    <h5 class="fw-bold mb-1">Forgot Password?</h5>
    <p class="text-muted small">Enter your email and we'll send a reset link</p>
</div>

<form asp-action="ForgotPassword" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

    <div class="mb-4">
        <label asp-for="Email" class="form-label fw-semibold small"></label>
        <div class="input-group">
            <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope text-muted"></i></span>
            <input asp-for="Email" class="form-control border-start-0 ps-0" placeholder="you@email.com" />
        </div>
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
        <i class="bi bi-send me-2"></i>Send Reset Link
    </button>

    <div class="text-center mt-3">
        <a asp-action="Login" class="small text-decoration-none">
            <i class="bi bi-arrow-left me-1"></i>Back to Login
        </a>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
