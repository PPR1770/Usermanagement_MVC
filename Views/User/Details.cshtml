@model ChatApp.Models.ApplicationUser
@{
    ViewData["Title"] = "User Details";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white border-0 pt-4 pb-0 px-4 d-flex justify-content-between">
                <h5 class="fw-bold"><i class="bi bi-person-circle me-2 text-primary"></i>User Details</h5>
                <a asp-action="Index" class="btn btn-sm btn-light">
                    <i class="bi bi-arrow-left me-1"></i>Back
                </a>
            </div>
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <div class="rounded-circle bg-primary text-white d-inline-flex align-items-center
                                justify-content-center fw-bold mb-2"
                         style="width:72px;height:72px;font-size:1.8rem">
                        @Model.FirstName.FirstOrDefault()@Model.LastName.FirstOrDefault()
                    </div>
                    <h5 class="mb-0">@Model.FirstName @Model.LastName</h5>
                    <span class="text-muted small">@Model.Email</span>
                </div>

                <table class="table table-borderless small">
                    <tr>
                        <td class="text-muted fw-semibold" style="width:140px">Username</td>
                        <td>@Model.UserName</td>
                    </tr>
                    <tr>
                        <td class="text-muted fw-semibold">Phone</td>
                        <td>@(string.IsNullOrEmpty(Model.PhoneNumber) ? "—" : Model.PhoneNumber)</td>
                    </tr>
                    <tr>
                        <td class="text-muted fw-semibold">Status</td>
                        <td>
                            <span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary")">
                                @(Model.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                    </tr>
                    <tr>
                        <td class="text-muted fw-semibold">Email Confirmed</td>
                        <td>
                            <span class="badge @(Model.EmailConfirmed ? "bg-success" : "bg-warning text-dark")">
                                @(Model.EmailConfirmed ? "Yes" : "No")
                            </span>
                        </td>
                    </tr>
                    <tr>
                        <td class="text-muted fw-semibold">Roles</td>
                        <td>
                            @foreach (var role in (IList<string>)ViewBag.Roles)
                            {
                                <span class="badge bg-primary me-1">@role</span>
                            }
                            @if (!((IList<string>)ViewBag.Roles).Any())
                            { <span class="text-muted">No roles assigned</span> }
                        </td>
                    </tr>
                    <tr>
                        <td class="text-muted fw-semibold">Registered</td>
                        <td>@Model.CreatedAt.ToString("MMMM dd, yyyy HH:mm")</td>
                    </tr>
                </table>

                @if (User.IsInRole("Admin"))
                {
                    <div class="d-flex gap-2 mt-3">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-sm">
                            <i class="bi bi-pencil me-1"></i>Edit
                        </a>
                        <form asp-action="ResetPassword" asp-route-id="@Model.Id" method="post"
                              onsubmit="return confirm('Reset password to Temp@123456?')">
                            <button class="btn btn-secondary btn-sm">
                                <i class="bi bi-key me-1"></i>Reset Password
                            </button>
                        </form>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
