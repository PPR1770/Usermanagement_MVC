@model UserManagementApp.Models.ApplicationUser
@{
    ViewData["Title"] = "Edit User";
    var allRoles  = (List<string>)ViewBag.AllRoles;
    var userRoles = (IList<string>)ViewBag.UserRoles;
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white border-0 pt-4 pb-0 px-4 d-flex justify-content-between">
                <h5 class="fw-bold"><i class="bi bi-pencil me-2 text-warning"></i>Edit User</h5>
                <a asp-action="Index" class="btn btn-sm btn-light"><i class="bi bi-arrow-left me-1"></i>Back</a>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    <div class="row g-3 mb-3">
                        <div class="col">
                            <label class="form-label fw-semibold small">First Name</label>
                            <input type="text" name="firstName" value="@Model.FirstName" class="form-control" required />
                        </div>
                        <div class="col">
                            <label class="form-label fw-semibold small">Last Name</label>
                            <input type="text" name="lastName" value="@Model.LastName" class="form-control" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Email</label>
                        <input type="text" value="@Model.Email" class="form-control" disabled />
                        <small class="text-muted">Email cannot be changed here.</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Phone Number</label>
                        <input type="text" name="phoneNumber" value="@Model.PhoneNumber" class="form-control" placeholder="Optional" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Status</label>
                        <div class="form-check form-switch mt-1">
                            <input class="form-check-input" type="checkbox" name="isActive"
                                   value="true" @(Model.IsActive ? "checked" : "") id="isActive" />
                            <label class="form-check-label" for="isActive">Active</label>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold small">Roles</label>
                        <div class="border rounded p-3">
                            @foreach (var role in allRoles)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox"
                                           name="roles" value="@role" id="role_@role"
                                           @(userRoles.Contains(role) ? "checked" : "") />
                                    <label class="form-check-label" for="role_@role">@role</label>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary fw-semibold">
                            <i class="bi bi-check-circle me-1"></i>Save Changes
                        </button>
                        <a asp-action="Index" class="btn btn-light">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
