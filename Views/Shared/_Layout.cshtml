@* #<!-- #region name Real Code -->

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UserManagement</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        :root { --sidebar-width: 250px; }
        body { background-color: #f4f6f9; }
        .sidebar {
            width: var(--sidebar-width);
            min-height: 100vh;
            background: linear-gradient(180deg, #1a1f2e 0%, #2d3450 100%);
            position: fixed;
            top: 0; left: 0;
            z-index: 1000;
            transition: all 0.3s;
        }
        .sidebar-brand {
            padding: 1.2rem 1.5rem;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            color: #fff;
            font-size: 1.2rem;
            font-weight: 700;
            text-decoration: none;
            display: block;
        }
        .sidebar .nav-link {
            color: rgba(255,255,255,0.7);
            padding: 0.7rem 1.5rem;
            border-radius: 0;
            transition: all 0.2s;
            font-size: 0.9rem;
        }
        .sidebar .nav-link:hover, .sidebar .nav-link.active {
            color: #fff;
            background: rgba(255,255,255,0.1);
            border-left: 3px solid #0d6efd;
        }
        .sidebar .nav-section {
            font-size: 0.7rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: rgba(255,255,255,0.35);
            padding: 1rem 1.5rem 0.3rem;
        }
        .main-content {
            margin-left: var(--sidebar-width);
            min-height: 100vh;
        }
        .topbar {
            background: #fff;
            border-bottom: 1px solid #dee2e6;
            padding: 0.75rem 1.5rem;
            position: sticky;
            top: 0;
            z-index: 999;
        }
        .content-area { padding: 1.5rem; }
        .stat-card { border: none; border-radius: 12px; transition: transform 0.2s; }
        .stat-card:hover { transform: translateY(-3px); }
        @@media (max-width: 768px) {
            .sidebar { transform: translateX(-100%); }
            .main-content { margin-left: 0; }
        }
    </style>
</head>
<body>
<!-- Sidebar -->
<div class="sidebar">
    <a class="sidebar-brand" href="/">
        <i class="bi bi-shield-lock-fill me-2"></i>User Management
    </a>
    <nav class="nav flex-column pt-2">
        <span class="nav-section">Main</span>
        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
           href="/Home/Index">
            <i class="bi bi-speedometer2 me-2"></i>Dashboard
        </a>

        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
        {
            <span class="nav-section">Management</span>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "User" ? "active" : "")"
               href="/User/Index">
                <i class="bi bi-people me-2"></i>Users
            </a>
        }
        @if (User.IsInRole("Admin"))
        {
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Role" ? "active" : "")"
               href="/Role/Index">
                <i class="bi bi-person-badge me-2"></i>Roles
            </a>
        }

        <span class="nav-section">Account</span>
        <a class="nav-link" href="/Account/ChangePassword">
            <i class="bi bi-key me-2"></i>Change Password
        </a>
        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
            <button type="submit" class="nav-link border-0 bg-transparent w-100 text-start">
                <i class="bi bi-box-arrow-left me-2"></i>Logout
            </button>
        </form>
    </nav>
</div>

<!-- Main Content -->
<div class="main-content">
    <!-- Topbar -->
    <div class="topbar d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-semibold text-secondary">@ViewData["Title"]</h6>
        <div class="d-flex align-items-center gap-3">
            <div class="dropdown">
                <button class="btn btn-sm btn-light dropdown-toggle" data-bs-toggle="dropdown">
                    <i class="bi bi-person-circle me-1"></i>
                    @User.Identity?.Name?.Split('@')[0]
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><a class="dropdown-item" href="/Account/ChangePassword"><i class="bi bi-key me-2"></i>Change Password</a></li>
                    <li><hr class="dropdown-divider"/></li>
                    <li>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="dropdown-item text-danger">
                                <i class="bi bi-box-arrow-left me-2"></i>Logout
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Page Content -->
    <div class="content-area">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @RenderBody()
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

<!-- #endregion --> *@

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UserManagement</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

    <style>
            :root {
                --sidebar-width: 250px;
                --sidebar-collapsed: 70px;
            }

            body {
                background-color: #f4f6f9;
                overflow-x: hidden;
            }

            /* Sidebar */
            .sidebar {
                width: var(--sidebar-width);
                min-height: 100vh;
                background: linear-gradient(180deg, #1a1f2e 0%, #2d3450 100%);
                position: fixed;
                top: 0;
                left: 0;
                transition: all 0.3s;
                z-index: 1000;
            }

                .sidebar.collapsed {
                    width: var(--sidebar-collapsed);
                }

                    .sidebar.collapsed span,
                    .sidebar.collapsed .nav-section {
                        display: none;
                    }

            .sidebar-brand {
                padding: 1.2rem;
                color: #fff;
                font-weight: bold;
                display: flex;
                align-items: center;
            }

            .nav-link {
                color: rgba(255,255,255,0.7);
                padding: 0.7rem 1.2rem;
                display: flex;
                align-items: center;
                transition: 0.2s;
            }

                .nav-link:hover {
                    color: #fff;
                    background: rgba(255,255,255,0.08);
                }

                .nav-link i {
                    width: 20px;
                }

                /* Active */
                .nav-link.active {
                    color: #fff;
                    background: linear-gradient(90deg, #0d6efd, #0b5ed7);
                    border-left: 4px solid #fff;
                    box-shadow: 0 2px 6px rgba(0,0,0,0.2);
                }

                .nav-link.parent.active {
                    background: rgba(255,255,255,0.08);
                }

            .nav-section {
                font-size: 0.7rem;
                color: rgba(255,255,255,0.4);
                padding: 1rem 1.2rem 0.3rem;
            }

            /* Submenu */
            .submenu {
                max-height: 0;
                overflow: hidden;
                transition: 0.3s ease;
            }

                .submenu.show {
                    max-height: 500px;
                }

            /* Arrow */
            .arrow {
                margin-left: auto;
                transition: transform 0.3s;
            }

                .arrow.rotate {
                    transform: rotate(180deg);
                }

            /* Main */
            .main-content {
                margin-left: var(--sidebar-width);
                transition: 0.3s;
            }

                .main-content.expanded {
                    margin-left: var(--sidebar-collapsed);
                }

            .topbar {
                background: #fff;
                padding: 10px 15px;
                border-bottom: 1px solid #ddd;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

            .toggle-btn {
                font-size: 20px;
                cursor: pointer;
            }

            @@media(max-width:768px) {
                .sidebar {
                    transform: translateX(-100%);
                }

                    .sidebar.show {
                        transform: translateX(0);
                    }

                .main-content {
                    margin-left: 0;
                }
            }

            /* Profile Dropdown */
.profile-dropdown {
    position: relative;
    cursor: pointer;
}

.profile-trigger {
    display: flex;
    align-items: center;
    gap: 8px;
    background: #f8f9fa;
    padding: 6px 12px;
    border-radius: 20px;
    transition: 0.2s;
}

.profile-trigger:hover {
    background: #e9ecef;
}

.profile-trigger i {
    font-size: 18px;
}

/* Dropdown Menu */
.profile-menu {
    position: absolute;
    right: 0;
    top: 110%;
    background: #fff;
    min-width: 180px;
    border-radius: 10px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.1);
    padding: 8px 0;
    display: none;
    animation: fadeIn 0.2s ease-in-out;
    z-index: 999;
}

.profile-dropdown:hover .profile-menu {
    display: block;
}

.dropdown-item {
    padding: 8px 15px;
    font-size: 14px;
    color: #333;
    display: flex;
    align-items: center;
}

.dropdown-item:hover {
    background: #f1f3f5;
}

.dropdown-divider {
    height: 1px;
    background: #eee;
    margin: 5px 0;
}

/* Animation */
@@keyframes fadeIn {
    from { opacity: 0; transform: translateY(5px); }
    to { opacity: 1; transform: translateY(0); }
}
    </style>
</head>

<body>

    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var isUserMenuOpen = currentController == "User" || currentController == "Role";
    }

    <!-- Sidebar -->
    <div id="sidebar" class="sidebar">

        <div class="sidebar-brand">
            <i class="bi bi-shield-lock-fill me-2"></i>
            <span>You Chat!</span>
        </div>

        <nav class="nav flex-column">

            <span class="nav-section">Main</span>

            <a class="nav-link @(currentController == "Home" ? "active" : "")"
                   href="/Home/Index">
                <i class="bi bi-speedometer2"></i>
                <span class="ms-2">Dashboard</span>
            </a>

            @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
            {
                <span class="nav-section">Management</span>

                <!-- Parent -->
                <a class="nav-link parent @(isUserMenuOpen ? "active" : "")"
                       onclick="toggleMenu('userMenu', this)">
                    <i class="bi bi-people"></i>
                    <span class="ms-2">User Management</span>
                    <i class="bi bi-chevron-down arrow @(isUserMenuOpen ? "rotate" : "")"></i>
                </a>

                <!-- Child -->
                <div id="userMenu" class="submenu @(isUserMenuOpen ? "show" : "")">

                    <a class="nav-link @(currentController == "User" ? "active" : "")"
                           href="/User/Index">
                        <i class="bi bi-person"></i>
                        <span class="ms-2">Users</span>
                    </a>

                    @if (User.IsInRole("Admin"))
                    {
                        <a class="nav-link @(currentController == "Role" ? "active" : "")"
                               href="/Role/Index">
                            <i class="bi bi-person-badge"></i>
                            <span class="ms-2">Roles</span>
                        </a>
                    }

                </div>
            }

            <span class="nav-section">Chat</span>
            <a class="nav-link @(currentController == "Chat" ? "active" : "")"
                   href="/Chat/Index">
                <i class="bi bi-chat-dots"></i>
                <span class="ms-2">Chat</span>
            </a>

            <span class="nav-section">Account</span>

            <a class="nav-link @(currentController == "Account" ? "active" : "")"
                   href="/Account/ChangePassword">
                <i class="bi bi-key"></i>
                <span class="ms-2">Change Password</span>
            </a>

            <form asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="nav-link border-0 bg-transparent w-100 text-start text-danger">
                    <i class="bi bi-box-arrow-left"></i>
                    <span class="ms-2">Logout</span>
                </button>
            </form>

        </nav>
    </div>

    <!-- Main -->
    <div id="main" class="main-content">

        <!-- Topbar -->
        <div class="topbar">

            <div>
                <i class="bi bi-list toggle-btn" onclick="toggleSidebar()"></i>
            </div>
            <div>
                <h6 class="mb-0 fw-semibold text-secondary">@ViewData["Title"]</h6>
            </div>

           <div class="profile-dropdown">

                <div class="profile-trigger">
                    <i class="bi bi-person-circle"></i>
                    <span>@User.Identity?.Name?.Split('@')[0]</span>
                    <i class="bi bi-chevron-down small"></i>
                </div>

                <div class="profile-menu">
                    <a href="/Account/Profile" class="dropdown-item">
                        <i class="bi bi-person me-2"></i>My Profile
                    </a>

                    <a href="/Account/Settings" class="dropdown-item">
                        <i class="bi bi-gear me-2"></i>Settings
                    </a>

                    <div class="dropdown-divider"></div>

                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="dropdown-item text-danger">
                            <i class="bi bi-box-arrow-left me-2"></i>Logout
                        </button>
                    </form>
                </div>

            </div>

        </div>

        <!-- Content -->
        <div class="p-3">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    @TempData["Success"]
                    <button class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show">
                    @TempData["Error"]
                    <button class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @RenderBody()

        </div>

    </div>

    <!-- Scripts -->
    <script>
            function toggleSidebar() {
                document.getElementById("sidebar").classList.toggle("collapsed");
                document.getElementById("main").classList.toggle("expanded");
            }

            function toggleMenu(id, el) {
                const menu = document.getElementById(id);
                const arrow = el.querySelector(".arrow");

                menu.classList.toggle("show");
                arrow.classList.toggle("rotate");
            }
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>