@{
    ViewData["Title"] = "Error";
}

<div class="text-center py-5">
    <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size:5rem;"></i>
    <h2 class="fw-bold mt-3">Something went wrong</h2>
    <p class="text-muted">An unexpected error occurred. Please try again or contact support.</p>
    @if (ViewData["RequestId"] != null)
    {
        <p class="text-muted small">Request ID: <code>@ViewData["RequestId"]</code></p>
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-2">
        <i class="bi bi-house me-2"></i>Go to Dashboard
    </a>
</div>
