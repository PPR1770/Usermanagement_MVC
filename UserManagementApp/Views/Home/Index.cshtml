@{
    ViewData["Title"] = "Dashboard";
}

<div class="row g-4 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card shadow-sm border-0 text-white" style="background:linear-gradient(135deg,#667eea,#764ba2)">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="bg-white bg-opacity-25 rounded-3 p-3">
                    <i class="bi bi-people-fill fs-4"></i>
                </div>
                <div>
                    <div class="fs-2 fw-bold">@ViewBag.TotalUsers</div>
                    <div class="small opacity-75">Total Users</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card shadow-sm border-0 text-white" style="background:linear-gradient(135deg,#11998e,#38ef7d)">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="bg-white bg-opacity-25 rounded-3 p-3">
                    <i class="bi bi-person-check-fill fs-4"></i>
                </div>
                <div>
                    <div class="fs-2 fw-bold">@ViewBag.ActiveUsers</div>
                    <div class="small opacity-75">Active Users</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card shadow-sm border-0 text-white" style="background:linear-gradient(135deg,#f093fb,#f5576c)">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="bg-white bg-opacity-25 rounded-3 p-3">
                    <i class="bi bi-person-badge-fill fs-4"></i>
                </div>
                <div>
                    <div class="fs-2 fw-bold">@ViewBag.TotalRoles</div>
                    <div class="small opacity-75">Total Roles</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card stat-card shadow-sm border-0 text-white" style="background:linear-gradient(135deg,#4facfe,#00f2fe)">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="bg-white bg-opacity-25 rounded-3 p-3">
                    <i class="bi bi-shield-check fs-4"></i>
                </div>
                <div>
                    <div class="fs-2 fw-bold">@ViewBag.TotalPermissions</div>
                    <div class="small opacity-75">Permissions</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-body">
                <h6 class="fw-bold mb-3"><i class="bi bi-lightning-charge text-warning me-2"></i>Quick Actions</h6>
                <div class="d-flex flex-column gap-2">
                    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                    {
                        <a href="/User/Index" class="btn btn-outline-primary text-start">
                            <i class="bi bi-people me-2"></i>Manage Users
                        </a>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <a href="/Role/Index" class="btn btn-outline-secondary text-start">
                            <i class="bi bi-person-badge me-2"></i>Manage Roles
                        </a>
                    }
                    <a href="/Account/ChangePassword" class="btn btn-outline-warning text-start">
                        <i class="bi bi-key me-2"></i>Change My Password
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-body">
                <h6 class="fw-bold mb-3"><i class="bi bi-person-circle text-primary me-2"></i>My Info</h6>
                <ul class="list-unstyled mb-0">
                    <li class="mb-2">
                        <span class="text-muted small">Email:</span><br />
                        <strong>@User.Identity?.Name</strong>
                    </li>
                    <li class="mb-2">
                        <span class="text-muted small">Roles:</span><br />
                        @if (User.IsInRole("Admin"))
                        { <span class="badge bg-danger">Admin</span> }
                        @if (User.IsInRole("Manager"))
                        { <span class="badge bg-warning text-dark">Manager</span> }
                        @if (User.IsInRole("User"))
                        { <span class="badge bg-secondary">User</span> }
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
